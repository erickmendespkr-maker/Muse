<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <application>
        <!-- Debug diagnostics must not be launchable by other installed apps.
             Internal explicit launches and developer tooling remain available. -->
        <activity
            android:name="leakcanary.internal.activity.LeakActivity"
            android:exported="false"
            tools:replace="android:exported" />
        <activity
            android:name="androidx.compose.ui.tooling.PreviewActivity"
            android:exported="false"
            tools:replace="android:exported" />
        <!-- These debug-only launch surfaces are merged from libraries.
             Keep them available to in-app tools/instrumentation, not other apps. -->
        <activity-alias
            android:name="leakcanary.internal.activity.LeakLauncherActivity"
            android:exported="false"
            tools:replace="android:exported" />
        <activity
            android:name="androidx.activity.ComponentActivity"
            android:exported="false"
            tools:replace="android:exported" />
    </application>
</manifest>
